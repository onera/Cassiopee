#!/bin/bash
# Print help message
usage() {
  cat <<EOF
Usage: $0                                             : Remove build/ and .sconsign.dblite for all modules listed in $CASSIOPEE/Cassiopee/MODULES
       $0 --force, -f                                 : Also uninstall the modules listed in MODULES from Cassiopee's site-packages 
                                                                  directory (package directories and .dist-info metadata) 
       $0 --help, -h                                  : Print help message
EOF
}

if [ -z "$CASSIOPEE" ]; then
    echo "Environment variable CASSIOPEE must be set."
    echo "CASSIOPEE identifies the root directory of the Cassiopee repository."
    usage >&2; exit 1
fi

# Handle help without consuming arguments
for arg in "$@"; do
    case "$arg" in
        --help|-h)
            usage; exit 0
            ;;
    esac
done

cd "$CASSIOPEE/Cassiopee"
./clean "$@"
