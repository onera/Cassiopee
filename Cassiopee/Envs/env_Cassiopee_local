# do not edit this file
if [ -e $CASSIOPEE/Cassiopee/Envs/sh_Cassiopee_r8 ]; then
    source $CASSIOPEE/Cassiopee/Envs/sh_Cassiopee_r8
elif [ -e $CASSIOPEE/Dist/sh_Cassiopee_r8 ]; then
    source $CASSIOPEE/Dist/sh_Cassiopee_r8
else
    echo 'Could not load env. File sh_Cassiopee_local not found.'
fi

TMPF=$HOME/.vars.csh
env | grep LD_LIBRARY_PATH | awk -F= '{printf "setenv %s %s\n", $1, $2}' > $TMPF
env | grep PYTHONPATH | awk -F= '{printf "setenv %s %s\n", $1, $2}' >> $TMPF
env | grep PATH | awk -F= '{printf "setenv %s %s\n", $1, $2}' >> $TMPF
env | grep ELSAPROD | awk -F= '{printf "setenv %s %s\n", $1, $2}' >> $TMPF
if [ -n "${PYTHONEXE}" ]; then
   env | grep PYTHONEXE | awk -F= '{printf "setenv %s %s\n", $1, $2}' >> $TMPF
fi
if [ -n "${OMP_NUM_THREADS}" ]; then
   env | grep OMP_NUM_THREADS | awk -F= '{printf "setenv %s %s\n", $1, $2}' >> $TMPF
fi
if [ -n "${PRODMODE}" ]; then
   env | grep PRODMODE | awk -F= '{printf "setenv %s %s\n", $1, $2}' >> $TMPF
fi
if [ -n "${PIP_DISABLE_PIP_VERSION_CHECK}" ]; then
   env | grep PIP_DISABLE_PIP_VERSION_CHECK | awk -F= '{printf "setenv %s %s\n", $1, $2}' >> $TMPF
fi
if [ -n "${ASAN_OPTIONS}" ]; then
   env | grep ASAN_OPTIONS | awk -F= '{ printf "setenv %s ", $1; for (i=2; i<NF; i++) printf "%s=", $i; printf "%s\n", $NF; }' >> $TMPF
fi
if [ -n "${LSAN_OPTIONS}" ]; then
   env | grep LSAN_OPTIONS | awk -F= '{ printf "setenv %s ", $1; for (i=2; i<NF; i++) printf "%s=", $i; printf "%s\n", $NF; }' >> $TMPF
fi
if [ -n "${ASAN_LIB}" ]; then
   env | grep ASAN_LIB | awk -F= '{printf "setenv %s %s\n", $1, $2}' >> $TMPF
fi

if [ -n "${XMODIFIERS}" ]; then
   env | grep XMODIFIERS | awk -F= '{printf "setenv %s %s=%s\n", $1, $2, $3}' >> $TMPF
fi

if [[ "$MAC" == juno* ]]; then
    echo "unsetenv SLURM*" >> $TMPF
    echo "unsetenv OMP_PLACES" >> $TMPF
    echo "unsetenv I_MPI*" >> $TMPF
    echo "unsetenv HYDRA_BOOTSTRAP" >> $TMPF
    echo "setenv SLURM_CONF_SERVER 10.33.131.11:6817" >> $TMPF
fi

exit

