if ($?CASSIOPEE == 0) then
    echo "Environment variable CASSIOPEE must be set."
    echo "CASSIOPEE identifies the root directory of the Cassiopee repository."
    exit
endif
# source env from bash env
if (-e $CASSIOPEE/Cassiopee/Envs/env_Cassiopee_local) then
   bash $CASSIOPEE/Cassiopee/Envs/env_Cassiopee_local
else
    if ( $?CASSIOPEE_INSTALL_PREFIX ) then
        set PREFIX = "$CASSIOPEE_INSTALL_PREFIX"
    else
        set PREFIX = "$CASSIOPEE"
    endif
    bash $PREFIX/Dist/env_Cassiopee_local
endif
chmod +x $HOME/.vars.csh
source $HOME/.vars.csh
rm -f $HOME/.vars.csh
if ("$PYTHONEXE" == "python3") then
   alias python python3
endif
#cat $HOME/.vars.csh
