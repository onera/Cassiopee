#!/bin/sh
echo 'Installing Distributor2 tests and doc'
if [ -z "$CASSIOPEE" ]; then
    echo "Environment variable CASSIOPEE must be set."
    echo "CASSIOPEE identifies the root directory of the Cassiopee repository."
    exit
fi

PRODUCTION=1
# Destination docs
DEST="$CASSIOPEE/docs/doc"
# Destination tests unitaires
DEST2="$DEST/Examples/Distributor2"

# Copy examples to global dir (production mod)
if ([ $PRODUCTION -eq 1 ])
then
    if test ! -e $DEST
    then 
        mkdir $DEST
    fi
    if test ! -e "$DEST/Examples"
    then 
        mkdir "$DEST/Examples"
    fi
    if test ! -e $DEST2
    then 
        mkdir $DEST2
    fi
    cp ../test/*.py $DEST2
fi

# Create Links for Examples (local)
if test ! -e build
then
    mkdir build
fi
cd build
if test ! -e Examples
then
    mkdir Examples
    ln -s $CASSIOPEE/Cassiopee/Distributor2/test Examples/Distributor2
fi
cd ..

# Build html
touch source/*.rst
sphinx-build -b html ./source ./build
[ $? -ne 0 ] && exit 1;
if ([ $PRODUCTION -eq 1 ])
then
# Build pdf
    sphinx-build -b latex ./source ./build
    [ $? -ne 0 ] && exit 1;
    cd build
    pdflatex Distributor2
    [ $? -ne 0 ] && exit 1;
    cd ..
fi

# Copie dans le DEST
if ([ $PRODUCTION -eq 1 ])
then
    sed -i 's/Distributor2.Distributor2/Distributor2/g' build/Distributor2.html
    cp build/Distributor2.html $DEST
    cp build/Distributor2.pdf $DEST
fi