#!/bin/sh
# Print help message
usage() {
  cat <<EOF
Usage: $0                                             : Install all modules
       $0 --all, -a                                   : Install modules and docs
       $0 --doc, -d                                   : Install docs only
       $0 --help, -h                                  : Print help message
EOF
}

if [ -z "$CASSIOPEE" ]; then
    echo "Environment variable CASSIOPEE must be set."
    echo "CASSIOPEE identifies the root directory of the Cassiopee repository."
    usage >&2; exit 1
fi

# Parse command-line arguments
INSTALL_DOCS=0
INSTALL_MODS=1
while [ -n "$1" ]; do
  case "$1" in
    --all | -a)
      INSTALL_DOCS=1
      INSTALL_MODS=1
      ;;
    --doc | -d)
      INSTALL_DOCS=1
      INSTALL_MODS=0
      ;;
    --help | -h)
      usage; exit 0
      ;;
    *)
      echo "Invalid argument: $1"
      usage >&2; exit 1
      ;;
  esac
  shift
done

if [ "$INSTALL_MODS" -eq 1 ]; then
    if [ -z "$ELSAPROD" ]; then
        echo "Environment variable ELSAPROD must be set."
        echo "ELSAPROD identifies the target machine or computing environment."
        usage >&2; exit 1
    fi
fi

if [ -z "$PYTHONEXE" ]; then
    export PYTHONEXE=python
fi

# Load module names
. ./MODULES

# Install modules and/or docs
for mod in $FULLMODULES
do
    if test -e $mod
    then
        cd $mod
        if [ "$INSTALL_MODS" -eq 1 ]; then
            ./install
            [ $? -ne 0 ] && exit 1;
        fi
        if [ "$INSTALL_DOCS" -eq 1 ]; then
            cd doc
            ./install
            [ $? -ne 0 ] && exit 1;
            cd ..
        fi
        cd ..
    else
        echo "Directory, $mod, not found."
    fi
done

# Install KCore doc for genindex
if [ "$INSTALL_DOCS" -eq 1 ]; then
    cd KCore/doc
    ./install
    [ $? -ne 0 ] && exit 1;
    cd ../..
fi

# Copy environment scripts
if [ "$INSTALL_MODS" -eq 1 ]; then
    PREFIX="${CASSIOPEE_INSTALL_PREFIX:-$CASSIOPEE}"
    cp Envs/env_Cassiopee* "$PREFIX/Dist"
    cp Envs/sh_Cassiopee*  "$PREFIX/Dist"
fi
