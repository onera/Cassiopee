#!/bin/sh
if [ -z "$CASSIOPEE" ]; then
    echo "Environment variable CASSIOPEE must be set."
    echo "CASSIOPEE identifies the root directory of the Cassiopee repository."
    exit 1
fi
if [ -z "$ELSAPROD" ]; then
    echo "Environment variable ELSAPROD must be set."
    echo "ELSAPROD identifies the target machine or computing environment."
    exit 1
fi

INSTALLPATH="${CASSIOPEE_INSTALL_PREFIX:-$CASSIOPEE/Dist/bin/$ELSAPROD}"

# if specific python exe name
if [ -n "$PYTHONEXE" ]; then
    alias python=$PYTHONEXE
fi

# set production mode (0: scons+setup, 1: scons+pip, 2: scons+pip+wheel)
if [ -z "$PRODMODE" ]; then
    PRODMODE=0
fi

# Compilation et installation
sconsf=`which scons`
[ $? -ne 0 ] && echo "Error: scons not found." && exit 1;
if [ -n "$OMP_NUM_THREADS" ]; then
    export SCONSOPT="-j $OMP_NUM_THREADS"
    echo "Parallel compilation on "$OMP_NUM_THREADS" cores"
else
    export SCONSOPT=""
fi
if [ -x "$sconsf" ]; then
    if head -c 100 "$sconsf" | grep -q python; then
        python $sconsf install prefix="$INSTALLPATH" "$SCONSOPT"
    else
        $sconsf install prefix="$INSTALLPATH" "$SCONSOPT"
    fi
else
    python $sconsf install prefix="$INSTALLPATH" "$SCONSOPT"
fi
[ $? -ne 0 ] && exit 1;
rm -f build/lib.*/KCore/kcore.*
rm -f build/lib.*/KCore/kcore-*.*
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PYTHONPATH="$SCRIPT_DIR/KCore${PYTHONPATH:+:$PYTHONPATH}" \
    python -c 'import sys, Dist; Dist.symLinks(sys.argv[1])' "$INSTALLPATH"

if [ $PRODMODE -eq 0 ]; then # setup
    INSTALL_PREFIX="$INSTALLPATH" \
        python setup.py install --prefix="$INSTALLPATH"
    [ $? -ne 0 ] && exit 1;
elif [ $PRODMODE -eq 1 ]; then # pip
    INSTALL_PREFIX="$INSTALLPATH" \
        python -m pip install --no-build-isolation --prefix="$INSTALLPATH" .
    [ $? -ne 0 ] && exit 1;
elif [ $PRODMODE -eq 2 ]; then # pip+wheel
    INSTALL_PREFIX="$INSTALLPATH" \
        python -m pip install --no-build-isolation --prefix="$INSTALLPATH" --no-clean .
    [ $? -ne 0 ] && exit 1;
elif [ $PRODMODE -eq 3 ]; then # pip no isolation
    INSTALL_PREFIX="$INSTALLPATH" \
        python -m pip install --disable-pip-version-check --no-deps --only-binary=:all: --no-build-isolation --prefix="$INSTALLPATH" .
    [ $? -ne 0 ] && exit 1;
fi

# Install libkcore
python installLib.py --prefix="$INSTALLPATH"

# Copie les scripts de notifications utilisateur
cp test/notifyCassiopee.py test/notifyCassiopee "$INSTALLPATH"

# LSAN: Ajoute un fichier pour supprimer certaines fuites memoire du log
cat > "$INSTALLPATH"/asan.supp <<EOF
leak:libOSMesa.so.*
leak:libopen-pal.so.*
leak:libopen-rte.so.*
leak:libc.so.*
leak:libstdc++.so.*
leak:libTKernel.so.*
leak:libTKVCAF.so.*
leak:libTKG3d.so.*
leak:Netgen/stlgeom/stlgeom.cpp
leak:Objects/obmalloc.c
leak:Objects/unicodeobject.c
leak:Objects/listobject.c
leak:Modules/gcmodule.c
leak:Python/thread_pthread.h
leak:KCore/Nuga/include/Polyhedron.h
leak:Converter/hook.cpp
leak:Converter/globalHook.cpp
leak:Converter/identifySolutions.cpp
leak:OCC/Atomic/readCAD.cpp
leak:PyObject_Malloc
leak:PyUnicode_FromKindAndData
leak:PyImport_ImportModuleLevelObject
leak:PyUFunc_FromFuncAndDataAndSignatureAndIdentity
leak:NpyString_new_allocator
leak:PyDataMem_UserNEW
leak:numpy/core/*
leak:numpy/_core/*
leak:mpi4py/*
EOF

# Check installation
python test/t1.py
