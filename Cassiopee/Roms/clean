#!/bin/bash
# Print help message
usage() {
  cat <<EOF
Usage: $0                                             : Remove build/ and .sconsign.dblite for $(basename "$PWD")
       $0 --force, -f                                 : Also uninstall $(basename "$PWD") from Cassiopee's site-packages
                                                               directory (package directories and .dist-info metadata) 
       $0 --help, -h                                  : Print help message
EOF
}

# Parse command-line arguments
REMOVE_DIST=0
while [ "$1" != "" ]; do
  case "$1" in
    --force | -f)
      REMOVE_DIST=1
      ;;
    --help | -h)
      usage; exit 0
      ;;
    *)
      echo "Invalid argument: $1"
      usage >&2; exit 1
      ;;
  esac
  shift
done

DIST_PYSITE=""
if [ "$REMOVE_DIST" -eq 1 ]; then
    DIST_PYSITE=$(echo "$PYTHONPATHL" | cut -d: -f2)
    [ -n "$DIST_PYSITE" ] && [ -d "$DIST_PYSITE" ] || { echo "Malformed site-packages directory"; exit 1; }
fi

mod="$(basename "$PWD")"
if [ -z "$ELSAPROD" ]; then
    rm -rf build
else
    rm -rf "build/$ELSAPROD"
    rm -rf build/bdist.* build/lib.* build/scripts-* build/temp.*
    if [ "$REMOVE_DIST" -eq 1 ]; then
        shopt -s nocaseglob
        rm -rf "$DIST_PYSITE/$mod" \
           "$DIST_PYSITE/cassiopee_${mod}-"*.dist-info \
           "$DIST_PYSITE/${mod}-"*.dist-info
        shopt -u nocaseglob
    fi
fi
rm -rf .sconsign.dblite __pycache__
shopt -s nocaseglob
rm -rf "${mod}"*.egg-info "cassiopee_${mod}"*.egg-info
shopt -u nocaseglob
