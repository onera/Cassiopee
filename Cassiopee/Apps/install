#!/bin/sh
if [ -z "$CASSIOPEE" ]; then
    echo "Environment variable CASSIOPEE must be set."
    echo "CASSIOPEE identifies the root directory of the Cassiopee repository."
    exit 1
fi
if [ -z "$ELSAPROD" ]; then
    echo "Environment variable ELSAPROD must be set."
    echo "ELSAPROD identifies the target machine or computing environment."
    exit 1
fi

INSTALLPATH="${CASSIOPEE_INSTALL_PREFIX:-$CASSIOPEE/Dist/bin/$ELSAPROD}"

# if specific python exe name
if [ -n "$PYTHONEXE" ]; then
    alias python=$PYTHONEXE
fi

# set production mode (0: scons+setup, 1: scons+pip, 2: scons+pip+wheel)
if [ -z "$PRODMODE" ]; then
    PRODMODE=0
fi

# Compilation et installation
if [ $PRODMODE -eq 0 ]; then # setup
    python setup.py install --prefix="$INSTALLPATH"
    [ $? -ne 0 ] && exit 1;
elif [ $PRODMODE -eq 1 ]; then # pip
    python -m pip install --no-build-isolation --ignore-installed --upgrade --prefix="$INSTALLPATH" .
    [ $? -ne 0 ] && exit 1;
elif [ $PRODMODE -eq 2 ]; then # pip+wheel
    # wheels in $INSTALLPATH
    TMPDIR=$INSTALLPATH python -m pip install --no-build-isolation --ignore-installed --upgrade --prefix="$INSTALLPATH" --no-clean .
    [ $? -ne 0 ] && exit 1;
elif [ $PRODMODE -eq 3 ]; then # pip no isolation
    python -m pip install --disable-pip-version-check --no-deps --only-binary=:all: --no-build-isolation --ignore-installed --upgrade --prefix="$INSTALLPATH" .
    [ $? -ne 0 ] && exit 1;
fi

# Check installation
python test/t1.py
