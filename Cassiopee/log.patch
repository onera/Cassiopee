-  }
-  else
+    size_type node;
+    size_type axis;
+  };
+
+  // KD-tree depth is log2(N), 128 is enough for practically all meshes
+  StackEntry stack[128];
+  E_Int top = 0;
+
+  stack[top++] = {root, axis};
+
+  while (top > 0)
   {
-    E_Float di2 = _posAcc.dist2(pt, *Ni);
-    if (di2 < d2)
+    StackEntry current = stack[--top];
+    size_type ci = current.node;
+    if (ci == IDX_NONE) continue;
+
+    const size_type* Ni = _tree.begin() + 3 * ci;
+    size_type ax = current.axis;
+    E_Float D = pt[ax] - _posAcc.getVal(*Ni, ax);
+    size_type left  = *(Ni+1);
+    size_type right = *(Ni+2);
+    size_type nextAxis = ax+1 == _dim ? 0 : ax+1;
