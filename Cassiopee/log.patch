+      E_Float di2 = _posAcc.dist2(pt, *Ni);
+      if (di2 < d2) { d2 = di2; m = *Ni; }
+
+      // Search both branches
+      stack[top++] = {left, nextAxis};
+      stack[top++] = {right, nextAxis};
