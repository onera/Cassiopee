#!/bin/bash
if [ -z "$CASSIOPEE" ]; then
    echo "Environment variable CASSIOPEE must be set."
    echo "CASSIOPEE identifies the root directory of the Cassiopee repository."
    exit
fi

PRODUCTION=1
# Destination docs
DEST="$CASSIOPEE/docs/doc"
# Destination tests unitaires
DEST2="$DEST/Examples/XCore"
# Destination des release notes
DEST3="$CASSIOPEE/docs/Download"

# do nothing for now
