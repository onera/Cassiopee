#! /bin/sh
PREFIX="${CASSIOPEE_INSTALL_PREFIX:-$CASSIOPEE}"
if [ -n "$PYTHONEXE" ]; then
    alias python=$PYTHONEXE
fi

if test -e "$PREFIX/Dist/bin/$ELSAPROD/validCassiopee.py"
then
    python "$PREFIX/Dist/bin/$ELSAPROD/validCassiopee.py" "$@"
else
    python "$PREFIX/Dist/bin/$ELSAPROD/validCassiopee.pyc" "$@"
fi
