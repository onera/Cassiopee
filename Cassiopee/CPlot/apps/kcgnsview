#!/bin/sh
PREFIX="${CASSIOPEE_INSTALL_PREFIX:-$CASSIOPEE}"
if [ -z "$PYTHONEXE" ]; then
    export PYTHONEXE=python
fi

if test -e "$PREFIX/Dist/bin/$ELSAPROD/tkcgnsview.py"
then
    $PYTHONEXE "$PREFIX/Dist/bin/$ELSAPROD/tkcgnsview.py" "$@"
else
    $PYTHONEXE "$PREFIX/Dist/bin/$ELSAPROD/tkcgnsview.pyc" "$@"
fi
