#! /bin/sh
PREFIX="${CASSIOPEE_INSTALL_PREFIX:-$CASSIOPEE}"
if [ -z "$PYTHONEXE" ]; then
    export PYTHONEXE=python
fi
export MPIRUN=0

if ! command -v xdpyinfo > /dev/null; then
    if test -e "$PREFIX/Dist/bin/$ELSAPROD/tkCassiopee.py"
    then
        $PYTHONEXE "$PREFIX/Dist/bin/$ELSAPROD/tkCassiopee.py" "$@"
    else
        $PYTHONEXE "$PREFIX/Dist/bin/$ELSAPROD/tkCassiopee.pyc" "$@"
    fi
    exit
fi

xdpyinfo | grep VNC > /dev/null
if [ $? -eq 0 ]; then
    if test -e "$PREFIX/Dist/bin/$ELSAPROD/tkCassiopee.py"
    then
        vglrun $PYTHONEXE "$PREFIX/Dist/bin/$ELSAPROD/tkCassiopee.py" "$@"
    else
        vglrun $PYTHONEXE "$PREFIX/Dist/bin/$ELSAPROD/tkCassiopee.pyc" "$@"
    fi
    exit
else
    if test -e "$PREFIX/Dist/bin/$ELSAPROD/tkCassiopee.py"
    then
        $PYTHONEXE "$PREFIX/Dist/bin/$ELSAPROD/tkCassiopee.py" "$@"
    else
        $PYTHONEXE "$PREFIX/Dist/bin/$ELSAPROD/tkCassiopee.pyc" "$@"
    fi
    exit
fi
