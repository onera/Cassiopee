#!/bin/sh
if [ -z "$CASSIOPEE" ]; then
    echo "Environment variable CASSIOPEE must be set."
    echo "CASSIOPEE identifies the root directory of the Cassiopee repository."
    exit 1
fi
if [ -z "$ELSAPROD" ]; then
    echo "Environment variable ELSAPROD must be set."
    echo "ELSAPROD identifies the target machine or computing environment."
    exit 1
fi

PREFIX="${CASSIOPEE_INSTALL_PREFIX:-$CASSIOPEE/Dist/bin/$ELSAPROD}"
INSTALLPATH="$PREFIX"

# if specific python exe name
if [ -n "$PYTHONEXE" ]; then
    alias python=$PYTHONEXE
fi

# set production mode (0: scons+setup, 1: scons+pip, 2: scons+pip+wheel)
if [ -z "$PRODMODE" ]; then
    PRODMODE=0
fi

# Compilation et installation
sconsf=`which scons`
[ $? -ne 0 ] && echo "Error: scons not found." && exit 1;
if [ -n "$OMP_NUM_THREADS" ]; then
    export SCONSOPT="-j $OMP_NUM_THREADS"
else
    export SCONSOPT=""
fi
if [ -x "$sconsf" ]; then
    if head -c 100 "$sconsf" | grep -q python; then
        python $sconsf install prefix="$INSTALLPATH" "$SCONSOPT"
    else
        $sconsf install prefix="$INSTALLPATH" "$SCONSOPT"
    fi
else
    python $sconsf install prefix="$INSTALLPATH" "$SCONSOPT"
fi
[ $? -ne 0 ] && exit 1;
#touch CPlot/cplot.cpp
rm -f build/lib.*/CPlot/cplot.*
rm -f build/lib.*/CPlot/cplot-*.*
rm -f build/lib.*/CPlot/cplotOSMesa.*
rm -f build/lib.*/CPlot/cplotOSMesa-*.*
if [ $PRODMODE -eq 0 ]; then # setup
    python setup.py install --prefix="$INSTALLPATH"
    [ $? -ne 0 ] && exit 1;
elif [ $PRODMODE -eq 1 ]; then # pip
    python -m pip install --no-build-isolation --ignore-installed --upgrade --prefix="$INSTALLPATH" .
    [ $? -ne 0 ] && exit 1;
elif [ $PRODMODE -eq 2 ]; then # pip+wheel
    TMPDIR=$INSTALLPATH python -m pip install --no-build-isolation --ignore-installed --upgrade --prefix="$INSTALLPATH" --no-clean .
    [ $? -ne 0 ] && exit 1;
elif [ $PRODMODE -eq 3 ]; then # pip no isolation
    python -m pip install --disable-pip-version-check --no-deps --only-binary=:all: --no-build-isolation --ignore-installed --upgrade --prefix="$INSTALLPATH" .
    [ $? -ne 0 ] && exit 1;
fi

cp test/cplot "$INSTALLPATH"
cp test/cplot.py "$INSTALLPATH"
# Copie les applications
cp apps/*.py "$INSTALLPATH"
cp apps/cassiopee "$INSTALLPATH"
cp apps/appCassiopee "$INSTALLPATH"
cp apps/CCC "$INSTALLPATH"
cp apps/cassiopee.bat "$INSTALLPATH"
cp apps/cassiopeeRunWin32.bat "$INSTALLPATH"
cp apps/cassiopeeRunWin64.bat "$INSTALLPATH"
cp apps/validCassiopee "$INSTALLPATH"
cp apps/validCassiopee.bat "$INSTALLPATH"
cp apps/kcgnsview "$INSTALLPATH"
python installThemes.py

# Test l'installation
python test/t1.py
